{
  "name": "shop-fit-sheet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test:release": "node --test scripts/release-guard.test.mjs && node scripts/check-reproducible-build.mjs",
    "test": "npm run build && npm run test:release && playwright test",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
